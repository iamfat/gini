<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" colors="true" bootstrap="./ci/bootstrap.php" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.3/phpunit.xsd">
  <coverage includeUncoveredFiles="true">
    <include>
      <directory suffix=".php">class</directory>
    </include>
  </coverage>
  <testsuites>
    <testsuite name="gini">
      <directory suffix=".php">./ci/test</directory>
    </testsuite>
  </testsuites>
</phpunit>
